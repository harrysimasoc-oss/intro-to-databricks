{
  "datasets": [
    {
      "name": "bakehouse_customers",
      "displayName": "Bakehouse Customers",
      "queryLines": [
        "SELECT continent, country, city, state, gender FROM samples.bakehouse.sales_customers"
      ]
    },
    {
      "name": "bakehouse_franchises",
      "displayName": "Bakehouse Franchises",
      "queryLines": [
        "SELECT franchiseID, name AS franchise_name, city, district, country, size FROM samples.bakehouse.sales_franchises"
      ]
    },
    {
      "name": "bike_bikes",
      "displayName": "Bike Daily Metrics",
      "queryLines": [
        "SELECT\n",
        "  ride_date,\n",
        "  bike_id,\n",
        "  total_rides,\n",
        "  total_revenue,\n",
        "  start_station_id,\n",
        "  end_station_id,\n",
        "  requires_maintenance\n",
        "FROM\n",
        "  bikes"
      ],
      "catalog": "main",
      "schema": "dbdemos_pipeline_bike"
    },
    {
      "name": "bike_rides",
      "displayName": "Bike Rides",
      "queryLines": [
        "SELECT\n",
        "  ride_date,\n",
        "  ride_id,\n",
        "  start_time,\n",
        "  end_time,\n",
        "  start_station_id,\n",
        "  end_station_id,\n",
        "  bike_id,\n",
        "  user_type,\n",
        "  ride_revenue\n",
        "FROM\n",
        "  rides"
      ],
      "catalog": "main",
      "schema": "dbdemos_pipeline_bike"
    },
    {
      "name": "bike_stations",
      "displayName": "Station Daily Metrics",
      "queryLines": [
        "SELECT\n",
        "  ride_date,\n",
        "  station_id,\n",
        "  total_rides_as_origin,\n",
        "  total_rides_as_destination,\n",
        "  end_of_day_inventory,\n",
        "  total_revenue_as_origin,\n",
        "  total_revenue_as_destination\n",
        "FROM\n",
        "  stations"
      ],
      "catalog": "main",
      "schema": "dbdemos_pipeline_bike"
    }
  ],
